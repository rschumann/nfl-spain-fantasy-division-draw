{
  "name": "nfl-spain-fantasy-division-draw",
  "version": "1.0.0",
  "description": "Deterministic, auditable, time-locked NFL Spain fantasy division draw with responsive chat",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json && esbuild src/server/netlify-handler.ts --bundle --platform=node --target=node20 --format=esm --outfile=netlify-dist-functions/api.js && cp netlify-dist-functions/api.js netlify/functions/api.js",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run -c vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "deps:check": "depcruise --config .dependency-cruiser.cjs src tests",
    "verify:limits": "node scripts/verify-file-limits.mjs",
    "verify:path": "node scripts/verify-private-path.mjs",
    "links": "node scripts/print-links.mjs",
    "verify": "npm run format:check && npm run lint && npm run verify:limits && npm run typecheck && npm run deps:check && npm run verify:path && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^8.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "firebase": "^11.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.21.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@netlify/functions": "^6.0.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.9",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/coverage-v8": "^3.0.7",
    "dependency-cruiser": "^16.10.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "firebase-tools": "^13.35.1",
    "happy-dom": "^17.4.5",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
