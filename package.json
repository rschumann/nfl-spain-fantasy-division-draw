{
  "name": "nfl-spain-fantasy-division-draw",
  "version": "1.0.0",
  "private": true,
  "description": "Public and verifiable NFL Spain fantasy division draw application",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server/index.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rules": "vitest run tests/rules",
    "test:e2e": "playwright test",
    "deps:check": "depcruise --config .dependency-cruiser.cjs src tests",
    "verify:path": "node scripts/verify-private-path.mjs",
    "verify:limits": "node scripts/verify-file-limits.mjs",
    "verify": "npm run format:check && npm run lint && npm run verify:limits && npm run typecheck && npm run deps:check && npm run verify:path && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "firebase": "^11.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/coverage-v8": "^3.0.8",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^9.21.0",
    "firebase-tools": "^13.31.2",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
